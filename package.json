{
  "name": "github-skyline-3d",
  "version": "1.0.0",
  "description": "An interactive 3D isometric GitHub contribution skyline component for React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanuka-upendra/github-skyline-3d.git"
  },
  "homepage": "https://github.com/shanuka-upendra/github-skyline-3d#readme",
  "bugs": {
    "url": "https://github.com/shanuka-upendra/github-skyline-3d/issues"
  },
  "keywords": [
    "react",
    "github",
    "contributions",
    "skyline",
    "3d",
    "isometric",
    "activity",
    "portfolio"
  ],
  "author": "Shanuka Upendra",
  "license": "MIT"
}
